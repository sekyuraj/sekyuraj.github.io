{
	storage file_system /var/lib/caddy
	persist_config off
}

sekraj.duckdns.org {
	encode zstd gzip

	route {
		# pages switched off in the Servers panel have a marker file here
		@off file {
			root /srv/sekraj-off
			try_files /off-{http.request.uri.path.0}
		}
		respond @off "This part of the site is switched off right now." 503

		reverse_proxy /api/* 127.0.0.1:3000
		reverse_proxy /chan* 127.0.0.1:3001
		reverse_proxy /cloud* 127.0.0.1:3002

		root * /srv/sekraj
		file_server
	}

	# the board (tuxchan) or the backend is stopped
	handle_errors 502 {
		respond "This part of the site is switched off right now." 503
	}
}
