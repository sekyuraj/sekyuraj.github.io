{
	storage file_system /var/lib/caddy
	persist_config off
}

sekraj.duckdns.org {
	encode zstd gzip

	# security headers; "?" = only when the app didn't set its own
	header {
		Strict-Transport-Security "max-age=31536000"
		?X-Content-Type-Options "nosniff"
		?Referrer-Policy "strict-origin-when-cross-origin"
		?X-Frame-Options "SAMEORIGIN"
		?Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
		?Cross-Origin-Opener-Policy "same-origin"
		# the static pages: everything from this site, nothing inline, no frames
		?Content-Security-Policy "default-src 'self'; img-src 'self' data:; media-src 'self'; font-src 'self'; connect-src 'self'; style-src 'self'; script-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
		-Server
	}
	# bios.html has a small inline script (pinned by hash) and inline style attributes
	@bios path /bios.html
	header @bios Content-Security-Policy "default-src 'self'; style-src 'unsafe-inline'; script-src 'sha256-iPzFTf/rLQGduscbpGzrbJJUzjcaXptEiNv14foFJFI='; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
	# film frames, sound and fonts never change under the same name
	@longcache path /rake/f/* /rake/m/* /rake/end/* /fonts/*
	header @longcache Cache-Control "public, max-age=604800"

	route {
		# pages switched off in the Servers panel have a marker file here
		@off file {
			root /srv/sekraj-off
			try_files /off-{http.request.uri.path.0}
		}
		respond @off "This part of the site is switched off right now." 503

		# hosted sites: /~name/ from /srv/sekhost/name. The sandbox CSP gives
		# every page a null origin, so its scripts can't touch logins here.
		@nosl path_regexp ^/~[a-z0-9._-]+$
		redir @nosl {path}/ 308
		@sites path /~*
		route @sites {
			header Content-Security-Policy "sandbox allow-scripts allow-forms allow-popups allow-modals allow-downloads"
			header X-Content-Type-Options nosniff
			uri strip_prefix /~
			root * /srv/sekhost
			file_server {
				hide .*
			}
		}

		reverse_proxy /api/* 127.0.0.1:3000
		reverse_proxy /chan* 127.0.0.1:3001
		reverse_proxy /cloud* 127.0.0.1:3002
		reverse_proxy /mail* 127.0.0.1:3003
		reverse_proxy /host* 127.0.0.1:3003

		root * /srv/sekraj
		file_server {
			hide .*
		}
	}

	# the board (tuxchan) or the backend is stopped
	handle_errors 502 {
		respond "This part of the site is switched off right now." 503
	}
}
